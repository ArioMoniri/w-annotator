{
  "name": "w-annotator",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "webkit:check": "node e2e-webkit/check.mjs",
    "e2e:desktop": "node --test --test-concurrency=1 --test-reporter=spec e2e-desktop/app.test.mjs e2e-desktop/rooms-restart.test.mjs",
    "selftest:desktop": "node e2e-desktop/selftest.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.7",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.8",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@cornerstonejs/codec-openjph": "^2.4.11",
    "@cornerstonejs/core": "5.19.4",
    "@cornerstonejs/tools": "5.19.4",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "webdriverio": "^10.2.0"
  },
  "author": "Ariorad Moniri",
  "license": "PolyForm-Noncommercial-1.0.0"
}
