<?xml version="1.0" encoding="UTF-8"?>
<!--
  File types W Annotator opens that the desktop does not know by itself.
  Installed to /usr/share/mime/packages by the .deb and .rpm, so that the
  MimeType line of the .desktop entry has something to match. DICOM
  (application/dicom, *.dcm) is already part of shared-mime-info.

  *.nii.gz is longer than *.gz, so it wins for compressed NIfTI and other
  .gz files keep their archive tool.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-nifti">
    <comment>NIfTI image</comment>
    <glob pattern="*.nii"/>
  </mime-type>
  <mime-type type="application/x-nifti-gz">
    <comment>NIfTI image (compressed)</comment>
    <sub-class-of type="application/gzip"/>
    <glob pattern="*.nii.gz"/>
  </mime-type>
  <mime-type type="application/x-metaimage">
    <comment>MetaImage</comment>
    <glob pattern="*.mha"/>
    <glob pattern="*.mhd"/>
  </mime-type>
  <mime-type type="application/x-nrrd">
    <comment>NRRD image</comment>
    <magic priority="50">
      <match type="string" offset="0" value="NRRD000"/>
    </magic>
    <glob pattern="*.nrrd"/>
    <glob pattern="*.nhdr"/>
  </mime-type>
</mime-info>
